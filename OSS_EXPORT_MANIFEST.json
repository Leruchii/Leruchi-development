{
  "version": 1,
  "purpose": "Explicit public OSS export allowlist for Fikunmii/vibeDB",
  "include": [
    "README.md",
    "LICENSE",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "docs/**",
    "packages/**",
    "apps/studio/**",
    "infra/**",
    "tests/**",
    "package.json",
    "package-lock.json",
    "docker-compose.yml",
    ".nvmrc",
    "scripts/assert-runtime-policy.mjs",
    "scripts/audit-baseui.sh",
    "scripts/benchmark-graph-renderer.mjs",
    "scripts/production-readiness-audit.mjs",
    "scripts/start-stage13-graph-api.mjs",
    "scripts/vibedb-backup.sh",
    "scripts/vibedb-restore.sh"
  ],
  "exclude": [
    ".agents/**",
    ".claude/**",
    ".github/workflows/**",
    "AGENTS.md",
    "BUILD_PLAN.md",
    "BUILD_STATE.md",
    "NORTH_STAR.md",
    "OSS_BOUNDARY.md",
    "knowledge/**",
    "prompts/**",
    "scripts/audit-oss-boundary.mjs",
    "CLAUDE.md",
    "OSS_EXPORT_MANIFEST.json",
    "scripts/oss-core-readiness-audit.mjs"
  ],
  "rule": "Only paths matched by include may be exported. Exclusions are defense-in-depth, not the primary boundary."
}
