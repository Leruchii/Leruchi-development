{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://leruchi.dev/context-ir/v1.schema.json",
  "title":"Leruchi Context IR v1",
  "type":"object",
  "additionalProperties":false,
  "required":["version","kind","purpose","sources","budget","freshness"],
  "properties":{
    "version":{"const":"v1"},
    "kind":{"const":"context_request"},
    "purpose":{"type":"string","minLength":1,"maxLength":500},
    "sources":{
      "type":"array","minItems":1,"maxItems":32,
      "items":{"$ref":"#/$defs/source"}
    },
    "budget":{
      "type":"object","additionalProperties":false,
      "required":["max_items","max_bytes"],
      "properties":{
        "max_items":{"type":"integer","minimum":1,"maximum":1000},
        "max_bytes":{"type":"integer","minimum":1024,"maximum":1048576}
      }
    },
    "freshness":{
      "type":"object","additionalProperties":false,
      "required":["mode"],
      "properties":{
        "mode":{"enum":["current","bounded_stale","cache_preferred"]},
        "max_age_seconds":{"type":"integer","minimum":0,"maximum":86400}
      }
    },
    "output":{
      "type":"object","additionalProperties":false,
      "properties":{
        "format":{"enum":["structured","text","hybrid"]},
        "include_provenance":{"type":"boolean"},
        "deduplicate":{"type":"boolean"}
      }
    },
    "extensions":{"type":"object","additionalProperties":false}
  },
  "$defs":{
    "safeIdentifier":{"type":"string","minLength":1,"pattern":"^[A-Za-z_][A-Za-z0-9_.]*$"},
    "source":{
      "type":"object","additionalProperties":false,
      "required":["type"],
      "properties":{
        "type":{"enum":["schema","query","retrieval","records"]},
        "catalog_ref":{"$ref":"#/$defs/safeIdentifier"},
        "ir":{"type":"object"},
        "identity_field":{"type":"string","pattern":"^[A-Za-z_][A-Za-z0-9_]*$"},
        "limit":{"type":"integer","minimum":1,"maximum":1000},
        "fields":{"type":"array","maxItems":100,"items":{"type":"string","pattern":"^[A-Za-z_][A-Za-z0-9_.]*$"}}
      }
    }
  }
}