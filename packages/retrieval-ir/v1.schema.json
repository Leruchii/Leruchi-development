{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://vibedb.dev/retrieval-ir/v1.schema.json",
  "title":"VibeDB Retrieval IR v1",
  "type":"object",
  "additionalProperties":false,
  "required":["version","kind","sources","fusion","limits"],
  "properties":{
    "version":{"const":"v1"},
    "kind":{"const":"retrieval_query"},
    "sources":{
      "type":"object","additionalProperties":false,"minProperties":1,
      "properties":{
        "vector":{
          "type":"object","additionalProperties":false,
          "required":["catalog_ref","query_parameter","top_k"],
          "properties":{
            "catalog_ref":{"type":"string","minLength":1},
            "query_parameter":{"type":"string","pattern":"^[A-Za-z_][A-Za-z0-9_]*$"},
            "top_k":{"type":"integer","minimum":1,"maximum":1000}
          }
        },
        "graph":{
          "type":"object","additionalProperties":false,
          "required":["query"],
          "properties":{
            "query":{"type":"object"},
            "candidate_limit":{"type":"integer","minimum":1,"maximum":1000}
          }
        }
      }
    },
    "fusion":{
      "type":"object","additionalProperties":false,
      "required":["strategy"],
      "properties":{
        "strategy":{"enum":["weighted_rrf"]},
        "vector_weight":{"type":"number","exclusiveMinimum":0},
        "graph_weight":{"type":"number","exclusiveMinimum":0}
      }
    },
    "limits":{
      "type":"object","additionalProperties":false,
      "required":["max_results","max_cost"],
      "properties":{
        "max_results":{"type":"integer","minimum":1,"maximum":1000},
        "max_cost":{"type":"integer","minimum":1,"maximum":100}
      }
    }
  }
}