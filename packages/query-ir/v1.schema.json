{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe.dev/query-ir/v1.schema.json",
  "title": "Vibe Query IR v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "kind",
    "graph",
    "root",
    "steps",
    "filters",
    "projection",
    "orderBy",
    "limit",
    "offset",
    "depth",
    "parameters"
  ],
  "properties": {
    "version": {
      "const": "v1"
    },
    "kind": {
      "const": "graph_query"
    },
    "graph": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "root": {
      "$ref": "#/$defs/node"
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "filters": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/filter"
      }
    },
    "projection": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/projection"
      }
    },
    "orderBy": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/order"
      }
    },
    "limit": {
      "type": "integer",
      "minimum": 1
    },
    "offset": {
      "type": "integer",
      "minimum": 0
    },
    "depth": {
      "type": "integer",
      "minimum": 0
    },
    "parameters": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/parameter"
      }
    },
    "extensions": {
      "type": "object",
      "additionalProperties": false
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "alias"
      ],
      "properties": {
        "label": {
          "$ref": "#/$defs/identifier"
        },
        "alias": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edge",
        "direction",
        "target"
      ],
      "properties": {
        "edge": {
          "$ref": "#/$defs/identifier"
        },
        "direction": {
          "enum": [
            "out",
            "in",
            "both"
          ]
        },
        "target": {
          "$ref": "#/$defs/node"
        }
      }
    },
    "field": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z_][A-Za-z0-9_.]*$"
    },
    "value": {
      "oneOf": [
        {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        {
          "type": "array"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "param"
          ],
          "properties": {
            "param": {
              "$ref": "#/$defs/identifier"
            }
          }
        }
      ]
    },
    "filter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "op",
        "value"
      ],
      "properties": {
        "field": {
          "$ref": "#/$defs/field"
        },
        "op": {
          "enum": [
            "eq",
            "neq",
            "gt",
            "gte",
            "lt",
            "lte",
            "in",
            "contains",
            "starts_with",
            "is_null"
          ]
        },
        "value": {
          "$ref": "#/$defs/value"
        }
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field"
      ],
      "properties": {
        "field": {
          "$ref": "#/$defs/field"
        },
        "alias": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "order": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "direction"
      ],
      "properties": {
        "field": {
          "$ref": "#/$defs/field"
        },
        "direction": {
          "enum": [
            "asc",
            "desc"
          ]
        }
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type",
        "required"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "type": {
          "enum": [
            "string",
            "integer",
            "number",
            "boolean",
            "uuid",
            "vector",
            "json"
          ]
        },
        "required": {
          "type": "boolean"
        }
      }
    }
  }
}
