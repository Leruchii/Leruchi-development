{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe.dev/query-ir/v1-error.schema.json",
  "title": "Vibe Query IR Error v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "code",
    "message"
  ],
  "properties": {
    "version": {
      "const": "v1"
    },
    "code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "path": {
      "type": "array",
      "items": {
        "type": [
          "string",
          "integer"
        ]
      }
    },
    "details": {
      "type": "object"
    }
  }
}
